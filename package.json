{
  "name": "nexus-verge-crpg-5e",
  "version": "1.0.0",
  "type": "module",
  "description": "A procedurally generated 5e-based roguelike CRPG. Uses content from the D&D 5e SRD (CC BY 4.0) with original mechanics. Explore infinite worlds with shareable seeds and turn-based tactical combat.",
  "main": "test.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" \"tests/**/*.js\" --fix",
    "lint:all": "eslint .",
    "lint:report": "eslint src/**/*.js --output-file eslint-report.txt",
    "legal:generate": "node scripts/generate_legal_artifacts.js",
    "legal:verify": "node scripts/verify_legal_compliance.js",
    "legal:verify-assets": "node scripts/verify_legal_compliance.js",
    "legal:all": "npm run legal:generate && npm run legal:verify",
    "gen:assets": "node tools/image-gen/generate.js",
    "gen:terrain": "node tools/image-gen/generate.js --type terrain",
    "gen:monsters": "node tools/image-gen/generate.js --type monsters",
    "gen:items": "node tools/image-gen/generate.js --type items",
    "gen:portraits": "node tools/image-gen/generate.js --type portraits"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.1.2",
    "eslint": "^9.39.2",
    "vitest": "^4.1.7"
  }
}
