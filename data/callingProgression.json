  "schema": {
    "automaticGrants": {
      "description": "Abilities/features/traits granted automatically at specific levels with no player choice",
      "structure": {
        "level": [
          {
            "type": "ability | spell | trait | feature",
            "id": "identifier matching data file",
            "source": "which data file/section (e.g., 'abilities.dedication', 'traits')",
            "description": "Why this is granted"
          }
        ]
      }
    },
    "automaticChoices": {
      "description": "Player must choose from a limited set of options at specific levels",
      "structure": {
        "level": [
          {
            "name": "Display name for the choice (e.g., 'Fighting Style')",
            "chooseFrom": "category identifier",
            "count": "number of choices (usually 1)",
            "description": "Help text for the player",
            "options": ["array", "of", "ids"],
            "source": "which data file contains the options"
          }
        ]
      }
    }
  }
