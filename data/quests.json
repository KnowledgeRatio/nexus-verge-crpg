        },
        {
          "type": "retrieve",
          "description": "Recover {itemName} from the {dungeonType}",
          "requirement": {
            "itemId": "{itemId}",
            "location": "dungeon"
          }
        },
        {
          "type": "return",
          "description": "Return {itemName} to {npcName}",
          "requirement": {
            "npcId": "{npcId}"
          }
        }
      ],
      "rewards": {
        "xpFormula": "300 * difficultyMultiplier",
        "goldFormula": "150 * difficultyMultiplier",
        "itemChance": 0.25,
        "reputation": {
          "faction": "settlement",
          "amount": 50
        }
      },
      "generation": {
        "validItemTypes": [
          "heirloom",
          "artifact",
          "treasure",
          "relic"
        ],
        "dungeonTypes": [
          "Cave",
          "Ruins",
          "Crypt",
          "Lair",
          "Hideout"
        ],
        "validNPCRoles": [
          "merchant",
          "innkeeper",
          "leader",
          "citizen"
        ]
      },
      "campaignIds": [
        "core"
      ]
    },
