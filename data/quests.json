{
  "description": "Quest templates for campaign and procedural side quest generation",
  "version": "1.0.0",
  "campaignQuests": [
    {
      "id": "campaign-stage-1",
      "stage": 1,
      "name": "The Monster Threat",
      "description": "Investigate the recent surge in monster attacks near {settlement}.",
      "type": "campaign",
      "difficulty": "normal",
      "objectives": [
        {
          "id": "obj-1",
          "type": "kill",
          "description": "Defeat 5 monsters within 50 tiles of {settlement}",
          "requirement": {
            "count": 5,
            "radius": 50,
            "anyCreature": true
          }
        },
        {
          "id": "obj-2",
          "type": "return",
          "description": "Report findings to the village elder",
          "requirement": {
            "npcRole": "leader",
            "settlementId": "{startSettlement}"
          }
        }
      ],
      "rewards": {
        "xp": 500,
        "gold": 100,
        "reputation": {
          "faction": "settlement",
          "amount": 50
        }
      },
      "nextStage": 2,
      "campaignIds": [
        "core"
      ]
    },
    {
      "id": "campaign-stage-2",
      "stage": 2,
      "name": "The Ancient Corruption",
      "description": "Discover the source of the monster corruption in the nearby ruins.",
      "type": "campaign",
      "difficulty": "hard",
      "objectives": [
        {
          "id": "obj-1",
          "type": "explore",
          "description": "Find and enter the ancient ruins",
          "requirement": {
            "featureType": "dungeon",
            "radius": 200
          }
        },
        {
          "id": "obj-2",
          "type": "retrieve",
          "description": "Recover the corrupted artifact",
          "requirement": {
            "itemId": "corrupted-artifact",
            "location": "dungeon"
          }
        },
        {
          "id": "obj-3",
          "type": "return",
          "description": "Bring the artifact to the village elder",
          "requirement": {
            "npcRole": "leader",
            "settlementId": "{startSettlement}"
          }
        }
      ],
      "rewards": {
        "xp": 1000,
        "gold": 250,
        "item": "potionOfGreaterHealing",
        "reputation": {
          "faction": "settlement",
          "amount": 100
        }
      },
      "nextStage": 3,
      "campaignIds": [
        "core"
      ]
    },
    {
      "id": "campaign-stage-3",
      "stage": 3,
      "name": "The Enemy Stronghold",
      "description": "Track the corruption to its source - an enemy fortress.",
      "type": "campaign",
      "difficulty": "hard",
      "objectives": [
        {
          "id": "obj-1",
          "type": "explore",
          "description": "Locate the enemy stronghold",
          "requirement": {
            "featureType": "fortress",
            "radius": 400
          }
        },
        {
          "id": "obj-2",
          "type": "kill",
          "description": "Defeat the stronghold's guardians",
          "requirement": {
            "count": 10,
            "location": "fortress",
            "minCR": 2
          }
        }
      ],
      "rewards": {
        "xp": 2000,
        "gold": 500,
        "item": "longsword-plus-1",
        "reputation": {
          "faction": "settlement",
          "amount": 150
        }
      },
      "nextStage": 4,
      "campaignIds": [
        "core"
      ]
    },
    {
      "id": "campaign-stage-4",
      "stage": 4,
      "name": "Confronting the BBEG",
      "description": "Face the mastermind behind the corruption and end the threat.",
      "type": "campaign",
      "difficulty": "deadly",
      "objectives": [
        {
          "id": "obj-1",
          "type": "kill",
          "description": "Defeat the Dark Sorcerer",
          "requirement": {
            "bossId": "dark-sorcerer",
            "location": "fortress"
          }
        }
      ],
      "rewards": {
        "xp": 5000,
        "gold": 1000,
        "item": "vorpal-sword",
        "reputation": {
          "faction": "all",
          "amount": 500
        },
        "gameComplete": true
      },
      "nextStage": null,
      "campaignIds": [
        "core"
      ]
    }
  ],
  "sideQuestTemplates": [
    {
      "id": "kill-creatures-basic",
      "name": "{creatureNamePlural} Menace",
      "description": "The local {npcRole} has asked you to deal with {count} {creatureName} threatening {settlement}.",
      "type": "kill",
      "difficulty": "normal",
      "objectives": [
        {
          "type": "kill",
          "description": "Slay {count} {creatureName}",
          "requirement": {
            "creatureTypes": [
              "{creatureType}"
            ],
            "count": "{countValue}",
            "location": {
              "nearSettlement": "{settlement}",
              "radius": 100
            }
          }
        }
      ],
      "rewards": {
        "xpFormula": "Math.max(150, creatureCR * count * 100)",
        "goldFormula": "creatureCR * count * 25",
        "reputation": {
          "faction": "settlement",
          "amount": 25
        }
      },
      "generation": {
        "minCR": 0.125,
        "maxCRFormula": "playerLevel + 2",
        "countRange": [
          3,
          8
        ],
        "validNPCRoles": [
          "innkeeper",
          "leader",
          "merchant",
          "guard"
        ]
      },
      "campaignIds": [
        "core"
      ]
    },
    {
      "id": "kill-creatures-elite",
      "name": "Hunt the {creatureName}",
      "description": "{npcName} needs a skilled hunter to eliminate a particularly dangerous {creatureName} that has been terrorizing travelers near {settlement}.",
      "type": "kill",
      "difficulty": "hard",
      "objectives": [
        {
          "type": "kill",
          "description": "Hunt and slay the elite {creatureName}",
          "requirement": {
            "creatureTypes": [
              "{creatureType}"
            ],
            "count": 1,
            "elite": true,
            "location": {
              "nearSettlement": "{settlement}",
              "radius": 150
            }
          }
        }
      ],
      "rewards": {
        "xpFormula": "Math.max(200, creatureCR * 200)",
        "goldFormula": "creatureCR * 50",
        "itemChance": 0.4,
        "reputation": {
          "faction": "settlement",
          "amount": 50
        }
      },
      "generation": {
        "minCRFormula": "playerLevel",
        "maxCRFormula": "playerLevel + 3",
        "validNPCRoles": [
          "leader",
          "guard",
          "innkeeper"
        ]
      },
      "campaignIds": [
        "core"
      ]
    },
    {
      "id": "retrieve-item-dungeon",
      "name": "Lost {itemType}",
      "description": "{npcName} has lost their precious {itemName} in the nearby {dungeonType}. They're offering a reward for its safe return.",
      "type": "retrieve",
      "difficulty": "hard",
      "objectives": [
        {
          "type": "explore",
          "description": "Find the {dungeonType}",
          "requirement": {
            "featureType": "dungeon",
