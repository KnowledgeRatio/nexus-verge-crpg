{
  "specializations": [
    {
      "_comment": "Example specialization for Dedication (Fighter + Monk)",
      "id": "bladedancer",
      "name": "Bladedancer",
      "calling": "dedication",
      "description": "Masters of agile combat, bladedancers blend martial prowess with graceful movement. They favor finesse weapons and high mobility.",
      "chosenAtLevel": 4,
      "primaryAttributes": ["dex", "wis"],
      "playstyle": "Mobile skirmisher with high AC and precision strikes",
      "flavorText": "You have dedicated yourself to the art of the blade dance, a fighting style that emphasizes speed, precision, and grace over brute force.",

      "specialAbilities": [
        {
          "level": 4,
          "type": "ability",
          "abilityId": "whirling_defense",
          "grantedAutomatically": true,
          "description": "Gained immediately when choosing Bladedancer"
        },
        {
          "level": 7,
          "type": "trait",
          "abilityId": "evasion",
          "grantedAutomatically": true,
          "description": "Automatically granted at level 7"
        },
        {
          "level": 10,
          "type": "trait",
          "abilityId": "mythic_bladedancer",
          "grantedAutomatically": true,
          "description": "Mythic capstone ability"
        }
      ],

      "unlockables": {
        "tier2": [
          "blade_flourish",
          "defensive_spin",
          "quickstep"
        ],
        "tier3": [
          "shadow_step",
          "perfect_dodge",
          "blade_storm"
        ]
      },

      "resourceModifications": {
        "ki": {
          "baseAmount": 4,
          "perLevel": 1,
          "description": "Bladedancers use ki points for special techniques"
        }
      },

      "recommendedWeaponMasteries": ["vex", "nick", "topple"],
      "recommendedAttributes": {
        "primary": "dex",
        "secondary": "wis",
        "description": "Prioritize DEX for AC and attacks, WIS for ki save DC"
      }
    },

    {
      "_comment": "Another Dedication specialization",
      "id": "juggernaut",
      "name": "Juggernaut",
      "calling": "dedication",
      "description": "Unstoppable tanks who wade into battle in heavy armor. They specialize in protection, control, and outlasting their foes.",
      "chosenAtLevel": 4,
      "primaryAttributes": ["str", "con"],
      "playstyle": "Tanky defender with area control and durability",
      "flavorText": "You have become an immovable object, a wall of steel that protects your allies and crushes your enemies.",

      "specialAbilities": [
        {
          "level": 4,
          "type": "ability",
          "abilityId": "shield_wall",
          "grantedAutomatically": true
        },
        {
          "level": 7,
          "type": "trait",
          "abilityId": "indomitable",
          "grantedAutomatically": true
        },
        {
          "level": 10,
          "type": "trait",
          "abilityId": "mythic_juggernaut",
          "grantedAutomatically": true
        }
      ],

      "unlockables": {
        "tier2": [
          "intimidating_presence",
          "shield_bash",
          "defensive_stance"
        ],
        "tier3": [
          "relentless",
          "heavy_armor_master",
          "bulwark"
        ]
      },

      "resourceModifications": {
        "stamina": {
          "baseAmount": 2,
          "perLevel": 1,
          "description": "Juggernauts use stamina for defensive abilities"
        }
      },

      "recommendedWeaponMasteries": ["push", "sap", "topple"],
      "recommendedAttributes": {
        "primary": "str",
        "secondary": "con",
        "description": "Prioritize STR for attacks, CON for survivability"
      }
    },

    {
      "_comment": "Scholar specialization example",
      "id": "arcanist",
      "name": "Arcanist",
      "calling": "scholar",
      "description": "Pure spellcasters who master arcane theory and devastating magical power. They know the most spells and can manipulate magic itself.",
      "chosenAtLevel": 4,
      "primaryAttributes": ["int"],
      "playstyle": "Glass cannon with versatile spellcasting and high spell damage",
      "flavorText": "You have devoted yourself to the study of pure magic, mastering spells that lesser wizards can only dream of.",

      "specialAbilities": [
        {
          "level": 4,
          "type": "trait",
          "abilityId": "spell_mastery",
          "grantedAutomatically": true,
          "description": "Choose 1 cantrip and 1 1st-level spell you can cast without expending spell slots"
        },
        {
          "level": 7,
          "type": "ability",
          "abilityId": "arcane_recovery",
          "grantedAutomatically": true,
          "description": "Recover spell slots on short rest"
        },
        {
          "level": 10,
          "type": "trait",
          "abilityId": "mythic_arcanist",
          "grantedAutomatically": true,
          "description": "Cast a 6th level spell without expending a spell slot once per long rest"
        }
      ],

      "unlockables": {
        "tier2": [
          "metamagic_careful",
          "metamagic_empowered",
          "spell_sculpting"
        ],
        "tier3": [
          "spell_penetration",
          "quickened_spell",
          "twinned_spell"
        ]
      },

      "resourceModifications": {
        "spellSlots": {
          "bonusSlots": {
            "1": 1,
            "2": 1
          },
          "description": "Arcanists gain extra spell slots"
        },
        "spellsKnown": {
          "bonusSpells": 2,
          "perLevel": 1,
          "description": "Arcanists know more spells than other Scholar specs"
        }
      },

      "recommendedAttributes": {
        "primary": "int",
        "secondary": "con",
        "description": "Maximize INT for spell power, CON for survivability"
      }
    }
  ],

  "_schema": {
    "description": "Schema definition for specializations.json",
    "required_fields": ["id", "name", "calling", "description", "chosenAtLevel", "primaryAttributes", "playstyle", "specialAbilities"],
    "optional_fields": ["flavorText", "unlockables", "resourceModifications", "recommendedWeaponMasteries", "recommendedAttributes"],
    "field_descriptions": {
      "id": "Unique identifier (lowercase, underscores)",
      "name": "Display name",
      "calling": "Parent calling ID",
      "description": "Short description of the specialization",
      "chosenAtLevel": "Always 4 for now (when Tier 2 begins)",
      "primaryAttributes": "Array of primary attributes (e.g., ['dex', 'wis'])",
      "playstyle": "One-line summary of playstyle",
      "flavorText": "Roleplay flavor text shown when chosen",
      "specialAbilities": [
        {
          "level": "Level when granted",
          "type": "ability | spell | trait",
          "abilityId": "ID of the ability/spell/trait",
          "grantedAutomatically": "Boolean - if true, automatically learned",
          "description": "Why/when this is granted"
        }
      ],
      "unlockables": {
        "tier2": "Array of unlockable IDs available to this spec in tier 2",
        "tier3": "Array of unlockable IDs available to this spec in tier 3",
        "tier4": "Array of unlockable IDs available to this spec in tier 4 (usually just capstone)"
      },
      "resourceModifications": {
        "resourceType": {
          "baseAmount": "Starting amount at level 1",
          "perLevel": "Amount gained per level",
          "bonusSlots": "For spell slots, object mapping level to bonus slots",
          "description": "Explanation of this resource"
        }
      },
      "recommendedWeaponMasteries": "Array of mastery IDs that synergize well",
      "recommendedAttributes": {
        "primary": "Primary attribute",
        "secondary": "Secondary attribute",
        "description": "Explanation of attribute priorities"
      }
    }
  },

  "_callings_needing_specs": [
    {
      "calling": "dedication",
      "specs": ["bladedancer", "juggernaut", "ascetic"]
    },
    {
      "calling": "scholar",
      "specs": ["arcanist", "artificer", "sage"]
    },
    {
      "calling": "pact",
      "specs": ["divine_champion", "voidcaller", "crusader"]
    },
    {
      "calling": "wanderlust",
      "specs": ["trickster", "performer", "shadow"]
    },
    {
      "calling": "bond",
      "specs": ["beastmaster", "shapeChanger", "warden"]
    },
    {
      "calling": "oath",
      "specs": ["devotion", "vengeance", "bloodhunter"]
    },
    {
      "calling": "instinct",
      "specs": ["berserker", "wildMage", "totem"]
    }
  ]
}
