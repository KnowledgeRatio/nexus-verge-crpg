{
  "description": "Reusable skill challenge templates for contextual gameplay with balance tuning",
  "version": "3.0.0",
  "note": "Updated for new 13-skill system with comprehensive balance framework. Skills: athletics, acrobatics, sleightOfHand, endurance, academia, arcana, investigation, perception, cunning, creativity, empathy, influence, deception.",

  "balancing": {
    "skillValueMultipliers": {
      "very_high": 0.5,
      "high": 0.75,
      "medium": 1.0,
      "low": 1.25,
      "very_low": 1.5
    },
    "baseRewardRates": {
      "xpPerDCPoint": 10,
      "goldPerDCPoint": 5,
      "lootChancePerDC": 0.02
    },
    "levelScaling": {
      "dcIncreasePerLevel": 0.5,
      "xpMultiplierPerLevel": 0.15,
      "goldMultiplierPerLevel": 0.20
    },
    "riskLevelModifiers": {
      "low": 0.8,
      "medium": 1.0,
      "high": 1.3,
      "deadly": 1.6
    },
    "criticalThresholds": {
      "naturalCrit": true,
      "marginCrit": true,
      "critMargin": 10,
      "critSuccessBonus": 0.5,
      "critFailureSeverity": 1.5
    },
    "triggerFrequencyModifiers": {
      "terrain_base": 0.10,
      "quest_objective": 1.0,
      "npc_dialogue": 0.30
    }
  },

  "challenges": {
    "trap_detect_disarm": {
      "id": "trap_detect_disarm",
      "name": "Trap Detection & Disarm",
      "description": "You notice suspicious markings on the floor ahead...",
      "type": "sequential",
      "balance": {
        "skillValue": "high",
        "rewardMultiplier": 0.75,
        "triggerFrequency": 0.15,
        "cooldown": 300000,
        "riskLevel": "medium",
        "lootChanceMultiplier": 0.8
      },
      "stages": [
        {
          "id": "detect",
          "skill": "perception",
          "baseDC": 13,
          "passiveRoll": true,
          "description": "Notice the trap before triggering it",
          "onSuccess": {
            "message": "You spot the trap mechanism!",
            "nextStage": "disarm"
          },
          "onFailure": {
            "message": "You trigger the trap!",
            "damage": "2d6",
            "damageType": "piercing"
          }
        },
        {
          "id": "disarm",
          "skill": "sleightOfHand",
          "baseDC": 14,
          "description": "Carefully disable the trap mechanism",
          "onSuccess": {
            "message": "You successfully disarm the trap!",
            "xp": 100,
            "gold": 25,
            "loot": {
              "table": "trapDisarm_common",
              "rolls": 1,
              "chance": 0.8,
              "rarityFilter": {
                "1-4": ["common"],
                "5-9": ["common", "uncommon"],
                "10+": ["uncommon", "rare"]
              }
            }
          },
          "onFailure": {
            "message": "Your hand slips...",
            "damage": "1d6",
            "damageType": "piercing"
          }
        }
      ],
      "criticalSuccess": {
        "xp": 150,
        "gold": 40,
        "message": "Masterful work! You find a hidden compartment with treasure",
        "loot": {
          "table": "trapDisarm_uncommon",
          "rolls": 2,
          "chance": 1.0
        }
      },
      "criticalFailure": {
        "damage": "3d6",
        "damageType": "piercing",
        "message": "The trap was more deadly than you thought..."
      },
      "contextualTriggers": {
        "exploration": {
          "featureType": ["dungeon", "ruins", "cave"],
          "terrain": ["dungeon"]
        },
        "quest": {
          "objectiveType": ["explore", "retrieve"]
        }
      }
    },

