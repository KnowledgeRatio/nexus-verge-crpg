      "type": "trait",
      "name": "Fighting Style: Mariner",
      "tier": 1,
      "calling": "dedication",
      "specialization": null,
      "category": "fightingStyle",
      "description": "As long as you are not wearing heavy armor or wielding a shield, you have a swimming speed equal to your walking speed, can swim through deep water terrain, and you gain a +1 bonus to AC.",
      "passive": true,
      "permanent": true,
      "effects": [
        {
          "type": "acBonus",
          "amount": 1,
          "condition": {
            "noHeavyArmor": true,
            "noShield": true
          }
        },
        {
          "type": "movement",
          "movementType": "swim",
          "speed": "@walkingSpeed",
          "condition": {
            "noHeavyArmor": true,
            "noShield": true
          }
        },
        {
          "type": "terrainTraversal",
          "terrain": "deepWater",
          "canTraverse": true,
          "condition": {
            "noHeavyArmor": true,
            "noShield": true
          }
        }
      ],
      "visualFeedback": {
        "icon": "🌊",
        "message": null
      },
