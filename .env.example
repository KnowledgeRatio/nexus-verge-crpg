# Nexus Verge - Environment Variables Template
# Copy this file to .env for local development (DO NOT commit .env)
#
# Read by tools/image-gen/ only. The game itself needs no environment variables,
# and the saves API reads its settings from api/local.settings.json instead.
# tools/image-gen/.env takes precedence over this file if both exist.

# ==================== Image Generation (tools/image-gen) ====================
# Azure AI Foundry — get these from Azure Portal → AI Foundry → Your Project

AZURE_FOUNDRY_ENDPOINT=https://your-name.services.ai.azure.com
AZURE_FOUNDRY_API_KEY=your-foundry-api-key-here

# Optional — defaults shown
# AZURE_PROVIDER=foundry              # 'foundry' or 'openai'
# AZURE_FOUNDRY_MODEL=MAI-Image-2e
# AZURE_RATE_LIMIT_MS=                # override the per-model rate limit

# Only used when AZURE_PROVIDER=openai
# AZURE_OPENAI_DEPLOYMENT=dall-e-3
# AZURE_OPENAI_API_VERSION=2024-02-01

# ==================== Notes ====================
# 1. Never commit this file with real values
# 2. Production secrets go in Azure Static Web Apps → Environment variables
