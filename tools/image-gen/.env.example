# Copy this to tools/image-gen/.env and fill in your API key.
# Never commit the filled .env file.
# This file is loaded automatically by generate.js — no --env-file flag needed.
# generate.js also checks the project root .env as a fallback.
#
# Endpoint: resource base URL only — from Azure portal > your AI Foundry resource > Keys and Endpoint
# Key: KEY1 or KEY2 from the same "Keys and Endpoint" page (resource level, not project level)

# --- Azure AI Foundry (default) ---
AZURE_FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_FOUNDRY_API_KEY=your-api-key-here
# MAI-Image-2.5 | MAI-Image-2.5-Flash | MAI-Image-2e | MAI-Image-2
AZURE_FOUNDRY_MODEL=MAI-Image-2.5

# Rate limit override in ms (auto-detected from model if unset):
#   2.5 / 2.5-Flash = 32000ms (2 RPM)   2e = 4000ms (18 RPM)   2 = 7000ms (9 RPM)
# AZURE_RATE_LIMIT_MS=32000

# --- Provider switch ---
# Omit or set to 'foundry' for MAI models (default).
# Set to 'openai' to use Azure OpenAI image generation instead.
# AZURE_PROVIDER=openai

# --- Azure OpenAI (only needed when AZURE_PROVIDER=openai) ---
# AZURE_OPENAI_DEPLOYMENT=dall-e-3
# AZURE_OPENAI_API_VERSION=2024-02-01
