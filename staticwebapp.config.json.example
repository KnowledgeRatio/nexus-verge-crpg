{
  "platform": {
    "apiRuntime": "node:20"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/data/*", "/src/*", "/assets/*", "/*.{css,js,json,png,jpg,jpeg,gif,svg,ico}"]
  },
  "routes": [
    {
      "route": "/api/*",
      "headers": {
        "Cache-Control": "no-store"
      }
    },
    {
      "route": "/data/*",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    },
    {
      "route": "/*.json",
      "headers": {
        "Cache-Control": "public, max-age=3600"
      }
    }
  ],
  "mimeTypes": {
    ".json": "application/json"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self';"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    },
    "401": {
      "statusCode": 401
    }
  }
}
