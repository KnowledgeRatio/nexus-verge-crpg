# Nexus Verge - Production .gitignore

# ==================== Operating System ====================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ==================== IDEs & Editors ====================

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# Claude Code local settings (machine-specific overrides)
.claude/settings.local.json

# JetBrains IDEs (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim
.netrwhist
*~
tags
[._]*.un~

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# ==================== Node.js & npm ====================

# Dependencies
node_modules/
jspm_packages/
bower_components/

# npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity
.pnp.*
.pnp/

# Package manager lock files (optional - uncomment if not tracking)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ==================== Build & Distribution ====================

# Build outputs
dist/
build/
out/
*.bundle.js
*.bundle.js.map

# Compiled binaries
*.exe
*.dll
*.so
*.dylib

# ==================== Logs & Debugging ====================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directories
coverage/
*.lcov
.nyc_output/
lib-cov/

# ==================== Environment & Config ====================

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Azure Functions local settings (contains secrets)
local.settings.json

# staticwebapp.config.json is intentionally tracked (NOT gitignored) - required by
# the Azure Static Web Apps GitHub Action at deploy time for routing/auth/header config.
# It contains a non-secret Azure AD tenant ID (an identifier, not a credential).

# Config files with secrets
config.local.js
secrets.json

# ==================== Testing ====================

# Test coverage
coverage/
.nyc_output/
*.lcov

# Test results
test-results/
junit.xml

# ==================== Temporary Files ====================

# Temporary files
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# Cache directories
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ==================== Game-Specific ====================

# Save files (if we want to exclude local saves from repo)
# Uncomment if save files should not be tracked
# saves/
# *.save

# User-generated content
# userdata/
# screenshots/

# ==================== Misc ====================

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env
.env.test
.env.production

# parcel-bundler cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/

# vuepress build output
.vuepress/dist

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v2
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# ==================== Project Specific ====================

# Backup files
*.backup
*.old
*-backup.txt

# Git conflict markers (should be resolved, not committed)
*.orig

# macOS folder attributes
.DS_Store

# ==================== Local Audit Reports ====================

# Security/history audit reports (document sensitive findings) - never commit
GIT_HISTORY_SECURITY_AUDIT.md
